# Public port for the self-hosted web application.
VIBE_INVEST_PORT=3000
# Bind the web application to loopback by default. Set explicitly only when a reverse proxy needs it.
VIBE_INVEST_HOST=127.0.0.1

# PostgreSQL bootstrap is used only on the first initialization of a new volume.
# Migration owns DDL; the application account has product-table DML only.
POSTGRES_BOOTSTRAP_PASSWORD=replace-bootstrap-password
MIGRATION_DATABASE_PASSWORD=replace-migration-password
DATABASE_PASSWORD=replace-application-password
# Optional local PostgreSQL access: docker compose -f compose.yaml -f compose.dev.yaml up
POSTGRES_DEV_PORT=5432

# Configure an OpenAI-compatible endpoint. No provider or URL is built in.
# MODEL_PROVIDER is a local label used for configuration and audit records.
MODEL_PROVIDER=
# Supported values: chat-completions, responses
MODEL_API_PROTOCOL=
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=

# Maximum number of analysis tasks running at once.
ANALYSIS_CONCURRENCY=2

# SEC requires an identifying User-Agent such as "Your Name email@example.com".
SEC_USER_AGENT=

# Alpaca Market Data. Basic accounts should keep the IEX feed.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_FEED=iex

# Optional: override the source configuration mounted inside Financial Data.
# MARKET_DATA_SOURCE_CONFIG=/app/config/sources.json
