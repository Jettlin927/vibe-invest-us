{
  "name": "vibe-invest-us",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/analysis-api",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "prototype": "npm run dev --workspace @vibe-invest/web -- --open '/prototype/workbench?variant=A'",
    "prototype:interface": "npm run dev --workspace @vibe-invest/web -- --open '/prototype/interface?variant=A'",
    "dev:web": "npm run dev --workspace @vibe-invest/web",
    "dev:api": "npm run dev --workspace @vibe-invest/analysis-api",
    "dev:data": "services/market-data/.venv/bin/uvicorn app.main:app --app-dir services/market-data --reload --port 8000 --no-access-log",
    "build": "npm run build --workspace @vibe-invest/contracts && npm run build --workspace @vibe-invest/domain && npm run build --workspace @vibe-invest/db && npm run build --workspace @vibe-invest/web && npm run build --workspace @vibe-invest/analysis-api",
    "pretest": "npm run build --workspace @vibe-invest/contracts && npm run build --workspace @vibe-invest/domain && npm run build --workspace @vibe-invest/db",
    "test": "node scripts/test.mjs",
    "pretest:unit": "npm run pretest",
    "test:unit": "node scripts/test.mjs --unit",
    "pretest:db": "npm run pretest",
    "test:db": "node scripts/test.mjs --db",
    "pretest:db:setup": "npm run pretest",
    "test:db:setup": "node scripts/test.mjs --setup",
    "eval:agent-runtime": "tsx services/analysis-api/eval/agent-runtime/run.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify:self-hosted": "sh scripts/verify-self-hosted.sh",
    "verify:real-analysis": "sh scripts/verify-real-analysis.sh",
    "test:data-sources": "services/market-data/.venv/bin/python scripts/test-data-sources.py"
  }
}
